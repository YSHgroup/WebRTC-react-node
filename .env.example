# ======================= REQUIRED =======================
# Neon Postgres. Added automatically when you connect Neon in Vercel → Storage / Marketplace.
DATABASE_URL=

# Signs login cookies. Generate: openssl rand -base64 48   (keep it secret, never change it casually)
AUTH_SECRET=

# ======================= FIREBASE (Authentication + Realtime Database) =======================
# Project settings → Service accounts → Generate new private key. Paste the WHOLE JSON file as one line.
FIREBASE_SERVICE_ACCOUNT=
# Optional if project_id is present in FIREBASE_SERVICE_ACCOUNT.
FIREBASE_PROJECT_ID=
# Realtime Database → Data tab, the URL at the top, e.g. https://my-app-default-rtdb.europe-west1.firebasedatabase.app
FIREBASE_DATABASE_URL=
# Project settings → General → Web API Key
FIREBASE_API_KEY=
# Project settings → General → Your apps → Web app → App ID (required for Firebase Authentication)
FIREBASE_APP_ID=
# Optional (defaults to <project-id>.firebaseapp.com)
FIREBASE_AUTH_DOMAIN=

# ======================= OPTIONAL / ACCOUNT VERIFICATION =======================
# Canonical production URL used by SEO metadata, sitemap, and robots.txt.
SITE_URL=

# Required for email/password accounts because email verification is on by default. https://resend.com
RESEND_API_KEY=
MAIL_FROM="Huddle <onboarding@resend.dev>"
# Email verification is enabled by default. Set false only if you intentionally want to disable it.
REQUIRE_EMAIL_VERIFICATION=true

# reCAPTCHA v3 bot protection on register/login (https://www.google.com/recaptcha/admin). Secret only here.
RECAPTCHA_SECRET_KEY=
# Public site key. The app serves it to the browser at runtime; it is not a secret.
RECAPTCHA_SITE_KEY=

# Hide emails/phones from other users (names and photos stay visible)
DIRECTORY_SHOW_CONTACT=true

# TURN relay for calls behind strict NATs — pick ONE option
CLOUDFLARE_TURN_KEY_ID=
CLOUDFLARE_TURN_API_TOKEN=
# or a static provider account (comma-separated URLs)
TURN_URLS=
TURN_USERNAME=
TURN_CREDENTIAL=
