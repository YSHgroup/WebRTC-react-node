# ---------- Firebase (client) — Project settings > Your apps > Web ----------
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# ---------- Firebase Admin (server only) — Project settings > Service accounts ----------
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
# keep the quotes and the \n sequences
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# ---------- Google reCAPTCHA v3 (free) — https://www.google.com/recaptcha/admin ----------
NEXT_PUBLIC_RECAPTCHA_SITE_KEY=
RECAPTCHA_SECRET_KEY=

# ---------- Email verification codes (Resend free tier) ----------
RESEND_API_KEY=
MAIL_FROM="Huddle <onboarding@resend.dev>"
# any long random string; used to hash OTP codes
OTP_SECRET=change-me

# ---------- Realtime transport ----------
# firestore = works on Vercel (default). socket = Socket.io (needs a long-running Node host).
NEXT_PUBLIC_REALTIME=firestore
# Leave empty to use the same origin (npm run dev:socket). Set to your Socket.io host when it is separate.
NEXT_PUBLIC_SOCKET_URL=
# Comma separated origins allowed to connect to the Socket.io server
SOCKET_CORS_ORIGINS=http://localhost:3000

# ---------- Site ----------
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ---------- Optional TURN server for calls behind strict NATs (e.g. Metered.ca free tier) ----------
NEXT_PUBLIC_TURN_URL=
NEXT_PUBLIC_TURN_USERNAME=
NEXT_PUBLIC_TURN_CREDENTIAL=
