rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }
    function isMember(cid) { return signedIn() && request.auth.uid in get(/databases/$(database)/documents/conversations/$(cid)).data.members; }

    // Profiles: any signed-in user can read; only the owner writes.
    match /users/{uid} {
      allow read: if signedIn();
      allow create, update: if request.auth.uid == uid;
    }

    match /conversations/{cid} {
      allow read: if signedIn() && request.auth.uid in resource.data.members;

      // Direct messages: two members, one of them is you, id is "<uidA>_<uidB>" sorted.
      allow create: if signedIn() && (
        (request.resource.data.type == 'dm'
          && request.resource.data.members.size() == 2
          && request.auth.uid in request.resource.data.members
          && cid == request.resource.data.members[0] + '_' + request.resource.data.members[1])
        ||
        // The five built-in public groups (created by whoever signs up first)
        (request.resource.data.type == 'group'
          && cid in ['development', 'hr', 'introduction', 'partners', 'topic-off']
          && request.resource.data.members == [request.auth.uid])
      );

      allow update: if signedIn() && (
        // members can bump lastMessage / updatedAt
        (request.auth.uid in resource.data.members
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['lastMessage', 'updatedAt']))
        ||
        // public groups: join yourself
        (resource.data.isPublic == true
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['members'])
          && request.resource.data.members.hasAll(resource.data.members)
          && request.resource.data.members.size() == resource.data.members.size() + 1
          && request.auth.uid in request.resource.data.members)
        ||
        // admins manage members, name and description
        (request.auth.uid in resource.data.admins
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['members', 'admins', 'name', 'description']))
        ||
        // anyone can leave a group
        (resource.data.type == 'group' && request.auth.uid in resource.data.members
          && !(request.auth.uid in request.resource.data.members)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['members', 'admins']))
      );

      match /messages/{mid} {
        allow read: if isMember(cid);
        allow create: if isMember(cid)
          && request.resource.data.senderId == request.auth.uid
          && request.resource.data.text.size() <= 4000;
      }

      match /typing/{uid} {
        allow read: if isMember(cid);
        allow write: if isMember(cid) && request.auth.uid == uid;
      }
    }

    // Call signalling (Firestore transport). Recipients read + delete; senders create.
    match /signals/{id} {
      allow create: if signedIn() && request.resource.data.from == request.auth.uid;
      allow read, delete: if signedIn() && resource.data.to == request.auth.uid;
    }

    // One-time codes are only touched by the Admin SDK.
    match /otps/{id} { allow read, write: if false; }
  }
}
